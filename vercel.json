{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/web/client/index.html"
    },
    {
      "source": "/descargas",
      "destination": "/web/client/descargas.html"
    },
    {
      "source": "/logo.png",
      "destination": "/web/client/logo.png"
    },
    {
      "source": "/data/(.*)",
      "destination": "/web/client/data/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    }
  ]
}
